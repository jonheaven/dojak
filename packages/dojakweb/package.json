{
  "name": "@dojak/web",
  "version": "2.0.0",
  "private": true,
  "description": "Proprietary first-party module — shared @dojak/web layer for our dApps on the open Dogenals standard (not for public npm / third-party use).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./wallet": {
      "import": "./dist/wallet.js",
      "types": "./wallet.d.ts"
    },
    "./dojakweb-host.css": "./dojakweb-host.css",
    "./wallet.css": "./dojakweb-host.css"
  },
  "scripts": {
    "build": "vite build --config vite.npm.config.ts",
    "build:lib": "vite build --config vite.lib.config.ts && vite build --config vite.wallet.config.ts && node scripts/verify-lib-exports.mjs && node scripts/verify-wallet-exports.mjs",
    "build:wallet": "vite build --config vite.wallet.config.ts && node scripts/verify-wallet-exports.mjs",
    "build:wallet-web-core": "pnpm --filter @dojak/core run build:wallet-web",
    "build:npm": "vite build --config vite.npm.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@dojak/biometrics": "workspace:*",
    "@dojak/core": "file:../core",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@ledgerhq/hw-app-btc": "^10.21.1",
    "@ledgerhq/hw-transport-webusb": "^6.32.0",
    "@mydogeofficial/dogecoin-js": "^0.1.2-dev.0",
    "@noble/secp256k1": "^3.0.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@scure/bip32": "^2.0.1",
    "@scure/bip39": "^2.0.1",
    "@tanstack/react-query": "^5.45.0",
    "@tauri-apps/api": "^2",
    "axios": "^1.6.5",
    "bitcoinjs-lib": "^7.0.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "doge-sdk": "^0.5.0-beta.5",
    "framer-motion": "^11.5.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.439.0",
    "next-intl": "^3.17.2",
    "pako": "^2.1.0",
    "qrcode.react": "^4.2.0",
    "react-dropzone": "^15.0.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.3.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/w3c-web-usb": "^1.0.13",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.17",
    "buffer": "^6.0.3",
    "postcss": "^8.4.33",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.6.3",
    "vite": "^8.0.1",
    "vite-plugin-dts": "^4.5.4"
  }
}
