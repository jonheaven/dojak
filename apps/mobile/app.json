{
  "expo": {
    "name": "Dojak",
    "slug": "dojak",
    "scheme": "dojak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dojak.wallet",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.dojak.wallet",
      "versionCode": 1,
      "minSdkVersion": 24,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#09090B"
      },
      "permissions": [
        "INTERNET"
      ]
    },
    "plugins": [
      "expo-dev-client",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "dojak-mobile"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    }
  }
}
