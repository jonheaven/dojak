{
  "manifest_version": 3,
  "name": "Dojak Wallet",
  "version": "0.1.2.0",
  "description": "Non-custodial Dogecoin wallet: DOGE, DRC-20, Doginals, Dunes, native X tipping, and one-click dApp connect.",
  "default_locale": "en",
  "homepage_url": "https://dojak.app",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "scripting",
    "windows",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dojak · Ð𝕏",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": ["x-overlay.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "content-script.js", "pageProvider.js", "x-overlay.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_page": "options.html"
}
