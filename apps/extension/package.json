{
  "name": "@dojak/extension",
  "version": "0.1.2.0",
  "private": true,
  "homepage": "https://github.com/dojak-wallet/extension#readme",
  "bugs": {
    "url": "https://github.com/dojak-wallet/extension/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dojak-wallet/extension.git"
  },
  "scripts": {
    "clean": "mkdir -p dist && rm -rf dist/* && cp -r build/_raw/* dist",
    "dev": "gulp build --env=dev --browser=chrome --manifest=mv3 --channel=github",
    "watch": "gulp watch --env=dev --browser=chrome --manifest=mv3 --channel=github",
    "build": "gulp build --env=pro --browser=chrome --manifest=mv3 --channel=github",
    "build:chrome:dev": "npm run build",
    "dev:watch": "npm run dev",
    "dev:reload": "npm run dev",
    "load:extension": "echo '🚀 QUICK DEVELOPMENT WORKFLOW:' && echo '' && echo '1. Build: npm run build (fast build)' && echo '2. Or watch: npm run dev (rebuilds on file changes)' && echo '3. Load extension:' && echo '   - Open Chrome → chrome://extensions/' && echo '   - Enable Developer mode (top right toggle)' && echo '   - Click \"Load unpacked\"' && echo '   - Select: dist/chrome/ folder' && echo '4. Test your changes!' && echo '' && echo '💡 Tip: Use npm run dev for auto-rebuilding during development'",
    "build:chrome": "gulp build --env=pro --browser=chrome --manifest=mv3 --channel=github",
    "build:firefox": "gulp build --env=pro --browser=firefox --manifest=mv2 --channel=github",
    "build:brave": "gulp build --env=pro --browser=brave --manifest=mv2 --channel=github",
    "build:edge": "gulp build --env=pro --browser=edge --manifest=mv2 --channel=github",
    "build:chrome:mv3:dev": "webpack --progress --env browser=chrome manifest=mv3 config=dev channel=github version=0.1.1.1",
    "build:chrome:mv3": "gulp build --env=pro --browser=chrome --manifest=mv3 --channel=dojak-store",
    "lint": "eslint src --fix --ext .js,.ts,.tsx,.json  && npm run format",
    "lint:fix": "eslint --fix src/**/*.{js,jsx,ts,tsx,json}",
    "analyze:deps": "npx depcheck --skip-missing --json",
    "analyze:exports": "npx ts-prune -p tsconfig.json --noExitCode",
    "_prettier": "prettier --write .",
    "fix:modules": "node scripts/fix-modules.js",
    "format": "prettier --write \"src/**/*.{js,jsx,md,ts,tsx}\" --plugin-search-dir=./node_modules/ --plugin=./node_modules/@trivago/prettier-plugin-sort-imports/ ",
    "postinstall": "node scripts/run-patch-package-if-needed.js",
    "prepare": "npm run fix:modules"
  },
  "dependencies": {
    "@ant-design/icons": "^4.7.0",
    "@babel/core": "^7.16.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@dojak/core": "workspace:*",
    "@dojak/web": "workspace:*",
