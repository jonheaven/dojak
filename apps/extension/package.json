    "case-sensitive-paths-webpack-plugin": "^2.4.0",
    "classnames": "^2.5.1",
    "compare-versions": "^4.1.3",
    "cross-env": "^7.0.3",
    "crypto-browserify": "^3.12.0",
    "css-loader": "^6.7.1",
    "css-minimizer-webpack-plugin": "^3.2.0",
    "dayjs": "^1.11.19",
    "debounce": "^1.2.1",
    "dotenv": "^10.0.0",
    "dotenv-expand": "^5.1.0",
    "ecpair": "^3.0.0",
    "eslint-webpack-plugin": "^3.1.1",
    "eth-rpc-errors": "^4.0.3",
    "extensionizer": "^1.0.1",
    "file-loader": "^6.2.0",
    "fs-extra": "^10.0.0",
    "glob": "^13.0.0",
    "hdkey": "^2.1.0",
    "html-webpack-plugin": "^5.5.0",
    "https-browserify": "^1.0.0",
    "i18next": "^21.8.1",
    "jest": "^27.4.3",
    "jest-watch-typeahead": "^1.0.0",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "koa-compose": "^4.1.0",
    "lint-staged": "^16.2.7",
    "lodash": "^4.17.21",
